{
  // 本站 markdown 校验（markdownlint）
  //   npm run lint:md       —— 校验日常撰写的内容（_posts / pages / _drafts / docs）
  //   npm run lint:md:fix   —— 自动修复可修的项
  //   npm run lint:md:all   —— 校验全仓库（含 _wiki / _fragments，仅供体检）
  //
  // 设计原则：只保留"能发现真实缺陷"的规则。
  // 纯风格类规则若与本站既有约定不符、或会在存量内容上产生大量噪音，
  // 一律关闭并在下面写明理由——一个报出上千条风格告警的 linter 会被无视，
  // 那样反而失去意义。

  // ── 开启：这些能发现真实缺陷 ───────────────────────────────────────

  // 标题层级跳跃（H2 → H4）。会破坏侧边目录的层级结构。
  "MD001": true,

  // 行尾空格：行尾 2 个空格在 Markdown 中是"硬换行"，多写少写都会
  // 改变渲染结果，且肉眼不可见。
  "MD009": {
    "br_spaces": 2,
    "list_item_empty_lines": false
  },

  // 连续空行：超过 2 行通常是编辑残留。
  "MD012": {
    "maximum": 2
  },

  // 同一父级下标题重名：会让侧边目录出现两个同名条目，
  // 且两者的锚点会互相覆盖（点谁都跳到前一个）。
  "MD024": {
    "siblings_only": true
  },

  // 单个 H1：文章页的 H1 由 layout 生成，正文再出现 H1 会导致
  // 页面出现两个一级标题（影响大纲与 SEO）。
  "MD025": {
    "front_matter_title": ""
  },

  // 用加粗行冒充标题：这类内容不会进入侧边目录，也拿不到锚点。
  // （本仓库已实际出现过该问题。）
  "MD036": true,

  // 行内代码 span 内外的多余空格：会改变代码内容本身。
  "MD038": true,

  // 链接文本内外的多余空格：会破坏链接文本。
  "MD039": true,

  // 围栏代码块缺少语言标注：Rouge 无法正确高亮。
  "MD040": true,

  // 空链接 / 空目标：形如 [文字](#) 的死链。
  "MD042": true,

  // 图片缺少 alt：无障碍与图片加载失败时的兜底文案。
  "MD045": true,

  // 锚点链接指向不存在的标题：站内互链最容易失效的一类，
  // 标题一改就断，肉眼极难发现。
  "MD051": true,

  // 文件必须以单个换行结尾。
  "MD047": true,

  // 围栏代码块统一用反引号（而非波浪号）。
  "MD048": {
    "style": "backtick"
  },

  // ── 关闭：与本站约定不符，或纯风格噪音 ─────────────────────────────

  // 行长限制：对中文无意义（中文没有"80 列"的传统，正文普遍整段成行）。
  "MD013": false,

  // 无序列表标记：存量 wiki 大量使用 `*`，与正文的 `-` 混用。
  // 统一它只是审美问题，且改动面极大。
  "MD004": false,

  // 嵌套列表缩进宽度：同上，存量内容缩进宽度不一。
  "MD007": false,

  // 硬制表符：存量内容里有，但渲染正常，不值得为此改动历史文件。
  "MD010": false,

  // 标题/列表/围栏前后空行：这三条在存量内容里命中数百处，
  // 绝大多数不影响渲染（Kramdown 容错良好），噪音远大于收益。
  // 注：新写的文章若缺空行导致渲染异常，人工预览即可发现。
  "MD022": false,
  "MD031": false,
  "MD032": false,

  // 引用块内的空行：中文引用常按段落分空行，属正常写法。
  "MD028": false,

  // 标题行尾标点：中文标题以「：」结尾是常见表达，误报多。
  "MD026": false,

  // 有序列表编号风格：存量内容编号方式不一。
  "MD029": false,

  // 内联 HTML：Jekyll 模板与正文大量使用 <br> / <img> / <kbd> / <section>，
  // 属本站既有做法。
  "MD033": false,

  // 裸 URL：文末"参考资料"刻意使用裸链接，可读性优于 <> 包裹。
  "MD034": false,

  // 文件首行必须是 H1：本站内容由 front matter + layout 决定标题，
  // _posts/_wiki/_fragments 正文都不以 H1 开头。
  "MD041": false,

  // 斜体/粗体符号：存量内容混用 * 与 _，统一属纯审美。
  "MD049": false,
  "MD050": false,

  // 命令前带 $ 提示符：这是刻意写法（表示"在 shell 中执行"）。
  "MD014": false,

  // 表格列风格：本站约定是"分隔行紧凑（|---|）+ 内容留空（| a |）"的
  // 混合写法，MD060 的 aligned/compact/tight 三种预设都无法表达，会全量误报。
  "MD060": false,

  // 代码块风格（缩进式 vs 围栏式）：统一用围栏，但存量内容无缩进式，
  // 该规则主要是为老旧文档准备，对本仓库无增量价值。
  "MD046": false
}
